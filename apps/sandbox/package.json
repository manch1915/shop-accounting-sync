{
  "name": "@sas/sandbox",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/main.ts",
    "start": "node dist/main.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.spec.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@hono/node-server": "2.1.5",
    "@sas/demo-data": "*",
    "hono": "4.13.13"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "tsx": "4.23.15",
    "vitest": "5.0.5"
  }
}
