{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": {
    "includes": ["**", "!**/dist", "!**/.next", "!**/generated", "!**/coverage", "!**/next-env.d.ts"]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 110
  },
  "javascript": {
    "formatter": { "quoteStyle": "single", "semicolons": "always", "trailingCommas": "all" },
    "parser": { "unsafeParameterDecoratorsEnabled": true }
  },
  "css": {
    "parser": { "tailwindDirectives": true }
  },
  "assist": { "actions": { "source": { "organizeImports": "on" } } },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "style": {
        "noNonNullAssertion": "warn"
      },
      "suspicious": {
        "noConsole": { "level": "error", "options": { "allow": ["error", "warn"] } }
      }
    }
  },
  "overrides": [
    {
      "includes": ["apps/api/**"],
      "linter": {
        "rules": {
          "style": { "useImportType": "off" }
        }
      }
    },
    {
      "includes": ["apps/sandbox/**", "**/scripts/**", "**/prisma/seed*.ts"],
      "linter": {
        "rules": { "suspicious": { "noConsole": "off" } }
      }
    }
  ]
}
