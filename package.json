{
  "name": "shop-accounting-sync",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -k -n sandbox,api,web -c magenta,cyan,green \"npm run dev -w @sas/sandbox\" \"npm run dev -w @sas/api\" \"npm run dev -w @sas/web\"",
    "build": "npm run build --workspaces --if-present",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "postinstall": "npm run build -w @sas/shared -w @sas/demo-data"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "typescript": "6.0.3",
    "concurrently": "10.0.6"
  }
}
