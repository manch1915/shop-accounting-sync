# Copy to .env and adjust. Comments are kept ASCII on purpose.

NODE_ENV=development
APP_ROLE=all
API_PORT=4000
PUBLIC_API_URL=http://localhost:4000
WEB_ORIGIN=http://localhost:3000

DATABASE_URL=postgresql://sync:sync@localhost:5433/sync
REDIS_URL=redis://localhost:6380

# 32 random bytes, base64. openssl rand -base64 32
ENCRYPTION_KEY=
SESSION_SECRET=

# Demo login (read-only viewer). Safe actions such as retry are allowed when true.
DEMO_ENABLED=true
DEMO_ALLOW_ACTIONS=true

# Sandbox that emulates WooCommerce, Shopify, MoySklad and Xero APIs
SANDBOX_URL=http://localhost:4010
SANDBOX_PORT=4010
SANDBOX_WEBHOOK_TARGET=http://localhost:4000
DEMO_GENERATOR=true

# Telegram alerts, optional
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
